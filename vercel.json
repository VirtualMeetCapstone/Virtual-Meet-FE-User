{
  "name": "vmeet",
  "build": {
    "env": {
      "NODE_ENV": "production"
    }
  },
  "routes": [
    {
      "src": ".*",
      "headers": { "x-prerender-bypass": "true" }
    },
    {
      "src": "/room/.*",
      "headers": { "x-prerender-bypass": "true" }
    },
    {
      "src": "/video/.*",
      "headers": { "x-prerender-bypass": "true" }
    }
  ]
}
