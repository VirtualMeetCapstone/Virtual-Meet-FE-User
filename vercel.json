{
  "version": 2,
  "name": "vmeet",
  "builds": [
    {
      "src": "dist/virtual-meet-fe/server/server.mjs",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/virtual-meet-fe/browser/**",
          "dist/virtual-meet-fe/server/**",
          "node_modules/zone.js/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "dist/virtual-meet-fe/browser/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/(.*)",
      "dest": "dist/virtual-meet-fe/server/server.mjs"
    }
  ]
}